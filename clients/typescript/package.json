{
  "name": "@slnt/sdk",
  "version": "0.1.1",
  "description": "TypeScript wallet SDK for the Slnt stealth-payment protocol (sRFC-0042)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susruth/slnt.git",
    "directory": "clients/typescript"
  },
  "bugs": {
    "url": "https://github.com/susruth/slnt/issues"
  },
  "homepage": "https://github.com/susruth/slnt#readme",
  "keywords": [
    "solana",
    "silent-payments",
    "stealth-addresses",
    "privacy",
    "wallet"
  ],
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "mocha",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^1.1.9",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.5",
    "chai": "^4.4.1",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.3.3"
  }
}
